# Solo demostración local. Si se cambia, usar un valor seguro para URL.
DB_PASSWORD=demo_local_only
WEB_PORT=8080
# Interfaz donde se publica la web. 127.0.0.1 solo esta máquina;
# 0.0.0.0 la expone a la red y a Internet (sin autenticación: ver README).
BIND_ADDR=127.0.0.1
# on: los pasajeros simulados caminan y se escribe histórico cada segundo.
# off: la simulación queda en pausa; lo ya registrado se conserva y se
#      sigue viendo en Insights dentro de la ventana consultada.
SIMULATION=on

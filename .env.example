# Solo demostración local. Si se cambia, usar un valor seguro para URL.
DB_PASSWORD=demo_local_only
WEB_PORT=8080
# Puerto HTTPS (certificado autofirmado). Hace falta para dar permiso de
# cámara desde OTRO equipo en la misma red (ej. un celular): el navegador
# solo concede getUserMedia en contexto seguro (HTTPS o localhost), así que
# http://<ip-lan>:8080 no sirve para eso aunque cargue la página igual.
WEB_TLS_PORT=8443
# Interfaz donde se publica la web. 127.0.0.1 solo esta máquina;
# 0.0.0.0 la expone a la red y a Internet (sin autenticación: ver README).
BIND_ADDR=127.0.0.1
# IP pública o dominio del servidor (va al certificado autofirmado de la web).
# Vacío en local.
PUBLIC_HOST=
# Imagen de PostgreSQL/PostGIS. Vacío = postgis/postgis:17-3.5 (solo amd64);
# en un servidor ARM usar imresamu/postgis:17-3.5.
DB_IMAGE=
# Servidor sin GPU: COMPOSE_PROFILES=modelo levanta también el modelo en vivo en
# CPU (servicio modelo-vivo) y ENLACE_CAMARA es el enlace que Teléfonos muestra
# para unir un teléfono (ej. https://<IP pública>/camara/). Vacíos en la laptop,
# donde el modelo corre con la GPU (python "Modelo/Test Modelo/camara_telefono.py").
COMPOSE_PROFILES=
ENLACE_CAMARA=
# Núcleos para el modelo en CPU (deja al menos uno para la web).
MODELO_CPUS=3
# Resolución del detector en CPU; vacío = 640 (la del Build). 480 es ~1,6x más rápido.
MODELO_IMGSZ=

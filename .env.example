# .env es opcional y no se versiona: ajustes de UNA máquina. En la laptop no
# hace falta (valen los valores por defecto de compose.yaml); en el servidor la
# configuración está en servidor.env y scripts/levantar.sh crea un .env solo con
# las contraseñas de las bases. Lo que se ponga en .env tiene prioridad sobre
# servidor.env, así que aquí todo va comentado: descomentar solo lo que se
# quiera cambiar en esa máquina.

# Contraseñas de las bases. Si se cambian, usar valores seguros para URL; una
# base ya creada conserva la contraseña con la que se creó.
# DB_PASSWORD=demo_local_only
# VIVO_DB_PASSWORD=vivo_local_only
# WEB_PORT=8080
# Puerto HTTPS (certificado autofirmado). Hace falta para dar permiso de
# cámara desde OTRO equipo en la misma red (ej. un celular): el navegador
# solo concede getUserMedia en contexto seguro (HTTPS o localhost), así que
# http://<ip-lan>:8080 no sirve para eso aunque cargue la página igual.
# WEB_TLS_PORT=8443
# Interfaz donde se publica la web. 127.0.0.1 solo esta máquina;
# 0.0.0.0 la expone a la red y a Internet (sin autenticación: ver README).
# BIND_ADDR=127.0.0.1
# IP pública o dominio del servidor (va al certificado autofirmado de la web).
# En el servidor la pone scripts/levantar.sh con la IP de la VM.
# PUBLIC_HOST=
# Imagen de PostgreSQL/PostGIS. Por defecto postgis/postgis:17-3.5 (solo
# amd64); en ARM, imresamu/postgis:17-3.5 (servidor.env ya la usa).
# DB_IMAGE=imresamu/postgis:17-3.5
# modelo levanta también el modelo en vivo en CPU (servicio modelo-vivo;
# servidor.env lo activa). En la laptop el modelo corre con la GPU
# (python "Modelo/Test Modelo/camara_telefono.py").
# COMPOSE_PROFILES=modelo
# Enlace que Teléfonos muestra para unir un teléfono. En el servidor lo pone
# scripts/levantar.sh (https://<IP pública>/camara/).
# ENLACE_CAMARA=
# Núcleos para el modelo en CPU (deja al menos uno para la web).
# MODELO_CPUS=3
# Resolución del detector en CPU; vacío = 640 (la del Build). 480 es ~1,6x más rápido.
# MODELO_IMGSZ=480

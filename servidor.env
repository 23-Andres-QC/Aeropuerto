# Configuración del servidor (VM de Google Cloud, ARM y sin GPU). La usa
# scripts/levantar.sh cuando corre en la VM; en la laptop no se lee y valen los
# valores por defecto de compose.yaml. Sin secretos: las contraseñas de las
# bases van en .env (no versionado), que el script crea la primera vez, y la IP
# pública (PUBLIC_HOST y ENLACE_CAMARA) la lee el script de la propia VM.
# Lo que se ponga en .env tiene prioridad sobre este archivo.

# Web para todos en los puertos estándar: el firewall de GCP solo abre 80 y 443
# (la cámara web va por el nginx de la web, en /camara/).
# La API exige credenciales propias (ADMIN_USER, ADMIN_PASSWORD, SESSION_SECRET y API_KEY): las crea
# scripts/levantar.sh en .env la primera vez. Con las de prueba de la laptop no arranca.
APP_ENV=servidor
BIND_ADDR=0.0.0.0
WEB_PORT=80
WEB_TLS_PORT=443
# postgis/postgis solo se publica para amd64; esta es la misma imagen
# (PostgreSQL 17 + PostGIS 3.5) construida también para arm64.
DB_IMAGE=imresamu/postgis:17-3.5
# El servidor queda solo con la web: el modelo en vivo corre en la PC con GPU y
# llega por un túnel SSH (python scripts/modelo_local.py). Para volver a correrlo
# aquí en CPU (servicio modelo-vivo): COMPOSE_PROFILES=modelo en .env.
COMPOSE_PROFILES=
# Núcleos para modelo-vivo si se activa (deja uno libre para la web y la API).
MODELO_CPUS=3
